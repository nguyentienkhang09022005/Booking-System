SPRING_APPLICATION_NAME=api-gateway

# Authentication Service
SPRING_CLOUD_GATEWAY_ROUTES_0_ID=auth-service
SPRING_CLOUD_GATEWAY_ROUTES_0_URI=
SPRING_CLOUD_GATEWAY_ROUTES_0_PREDICATES_0=Path=

# Java Service
SPRING_CLOUD_GATEWAY_ROUTES_1_ID=java-service
SPRING_CLOUD_GATEWAY_ROUTES_1_URI=
SPRING_CLOUD_GATEWAY_ROUTES_1_PREDICATES_0=Path=

# Golang Service
# Predicates must include /web3/payment/** for Web3/VND Stablecoin endpoints.
# Example: GOLANG_SERVICE_PREDICATES=Path=/api/v1/payments/**,/web3/payment/**,/report-revenues/**,/report-revenues-detail/**,/report-type-room-booking/**
SPRING_CLOUD_GATEWAY_ROUTES_2_ID=golang-service
SPRING_CLOUD_GATEWAY_ROUTES_2_URI=
SPRING_CLOUD_GATEWAY_ROUTES_2_PREDICATES_0=Path=

# Nodejs Service
SPRING_CLOUD_GATEWAY_ROUTES_3_ID=nodejs-service
SPRING_CLOUD_GATEWAY_ROUTES_3_URI=
SPRING_CLOUD_GATEWAY_ROUTES_3_PREDICATES_0=Path=