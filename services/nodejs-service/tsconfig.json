{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "noEmit": true,                    
    "allowImportingTsExtensions": true 
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}