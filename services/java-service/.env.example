# ==========================================
# SERVER CONFIG
# ==========================================
SPRING_APPLICATION_NAME=java-service

# ==========================================
# RELATIONAL DATABASE (PostgreSQL)
# ==========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<db_name>
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_pass
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# ==========================================
# NOSQL DATABASE (MongoDB)
# ==========================================
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db_name>?retryWrites=true&w=majority

# ==========================================
# CACHING (Redis - Upstash/Railway)
# ==========================================
REDIS_HOST=<your_redis_host>
REDIS_PORT=<port>
REDIS_PASSWORD=<password>
REDIS_SSL_ENABLED=true
REDIS_TIMEOUT=2000

# ==========================================
# MESSAGE BROKER (RabbitMQ - CloudAMQP)
# ==========================================
RABBITMQ_HOST=<your_rabbitmq_host>
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<user>
RABBITMQ_PASSWORD=<password>
RABBITMQ_VIRTUAL_HOST=<vhost>

# RabbitMQ Routing & Queues (Notification only)
RABBITMQ_EXCHANGE_NOTIFICATION=exchange.notification
RABBITMQ_QUEUE_NOTIFICATION=queue.notification
RABBITMQ_ROUTING_KEY_NOTIFICATION=routing.key.notification

# ==========================================
# EXTERNAL APIs (Cloudinary & Gemini)
# ==========================================
CLOUDINARY_CLOUDNAME=your_cloud_name
CLOUDINARY_APIKEY=your_api_key
CLOUDINARY_APISECRET=your_api_secret

GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent
GEMINI_APIKEY_USER=your_gemini_user_api_key
GEMINI_APIKEY_COMPANY=your_gemini_company_api_key

# ==========================================
# SECURITY & INTERNAL SERVICES
# ==========================================
JWT_SIGNERKEY=nhap_mot_chuoi_bi_mat_dai_va_phuc_tap_vao_day

GOLANG_SERVICE=http://localhost:8083 # Hoặc URL host thật
JAVA_SERVICE=http://localhost:8082