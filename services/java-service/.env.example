# Application
SPRING_APPLICATION_NAME=java-service

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/booking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/booking

# Hibernate / JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# JWT
JWT_SIGNERKEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT=60000

# Cloudinary (Image Upload)
CLOUDINARY_CLOUDNAME=
CLOUDINARY_APIKEY=
CLOUDINARY_APISECRET=

# Service URLs
GOLANG_SERVICE=http://localhost:8081
JAVA_SERVICE=http://localhost:8083

# Gemini AI
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
GEMINI_APIKEY_USER=
GEMINI_APIKEY_COMPANY=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# RabbitMQ — Report Exchange
RABBITMQ_EXCHANGE_REPORT=
RABBITMQ_QUEUE_REPORT=
RABBITMQ_ROUTING_KEY_REPORT=

# RabbitMQ — Report Update Exchange
RABBITMQ_EXCHANGE_UPDATE_REPORT=
RABBITMQ_QUEUE_UPDATE_REPORT=
RABBITMQ_ROUTING_KEY_UPDATE_REPORT=

# RabbitMQ — Notification Exchange
RABBITMQ_EXCHANGE_NOTIFICATION=
RABBITMQ_QUEUE_NOTIFICATION=
RABBITMQ_ROUTING_KEY_NOTIFICATION=
